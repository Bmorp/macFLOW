# Local backups
.merge-backup-*/

# Promo films: renders, caches and media stay local.
# The music and effects are licensed (Pixabay) and the font is Apple's SF Pro, so neither can be redistributed;
# frames and renders are regenerated by the tools in promo/.
promo/**/renders/
promo/**/assets/
promo/**/.hyperframes/
promo/**/.thumbnails/
promo/**/.waveform-cache/
node_modules/
